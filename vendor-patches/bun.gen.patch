+//! Embedding entry points for hosting Bun's JavaScript VM inside another
+//! process (the Chord `rbun` experiment; see `crates/rbun` in Chord).
+//!
+//! This mirrors the process-level init done by `bin_entry::main` and the VM
+//! boot done by `cli::run_command::Run::boot`, minus everything that is
+//! CLI-specific (argument parsing, bunfig, `Global::exit` on failure, the
+//! run-to-completion event loop), and exposes a very small C ABI on top of
+//! it. Everything value-level is done by the host through JavaScriptCore's
+//! public C API (`<JavaScriptCore/JavaScript.h>`): a `JSValueRef` is
+//! bit-identical to [`bun_jsc::JSValue`] on 64-bit targets and a
+//! `JSGlobalObject*` *is* a `JSGlobalContextRef` (see `APICast.h`), so no
+//! extra bridging is required beyond what is exported here.
+//!
+//! Threading contract: `bun_embed_init` runs once per process; every other
+//! function must be called from the single thread that created the VM, which
+//! holds the JSC API lock for its whole lifetime (like the CLI's `Run::start`).
+
+#![allow(clippy::missing_safety_doc)]
+
+use core::cell::RefCell;
+use core::ffi::{c_char, c_int, c_void};
+use std::sync::{Once, OnceLock};
+
+use bun_core::{EncodedSlice, StackCheck, output};
+use bun_jsc::js_promise::Status as PromiseStatus;
+use bun_jsc::virtual_machine::{InitOptions, VirtualMachine};
+use bun_jsc::{JSGlobalObject, JSValue};
+use bun_options_types::context::TestOptions;
+use bun_options_types::schema::api;
+
+use crate::cli::test_command::{
+    CommandLineReporter, ReportersConfig, TestCommand, skip_exit_listeners,
+};
+use crate::test_runner::bun_test::{BunTestRoot, FirstLast};
+use crate::test_runner::jest::{self, CurrentFile, FileList, FileMap, Summary, TestRunner};
+use crate::test_runner::snapshot::Snapshots;
+
+static PROCESS_INIT: Once = Once::new();
+static PROCESS_TEST_MODE: OnceLock<bool> = OnceLock::new();
+
+thread_local! {
+    static LAST_ERROR: RefCell<String> = const { RefCell::new(String::new()) };
+    static TEST_REPORTER: core::cell::Cell<*mut CommandLineReporter> =
+        const { core::cell::Cell::new(core::ptr::null_mut()) };
+}
+
+/// Stable test result returned through the embedding ABI. Keep this plain-C:
+/// rbun mirrors it in `src/ffi.rs`.
+#[repr(C)]
+#[derive(Default)]
+pub(crate) struct BunEmbedTestResult {
+    pub pass: u32,
+    pub fail: u32,
+    pub skip: u32,
+    pub todo: u32,
+    pub expectations: u32,
+    pub files: u32,
+    pub unhandled_errors: u32,
+}
+
+fn set_last_error(message: String) {
+    LAST_ERROR.with(|cell| *cell.borrow_mut() = message);
+}
+
+/// Dispatch Bun's private subprocess modes before the embedding host performs
+/// any ordinary startup. `Bun.WebView` re-executes the current executable
+/// with `BUN_INTERNAL_WEBVIEW_HOST` set; the child must enter Bun's native
+/// CoreFoundation/WebKit host loop instead of parsing the embedding host's
+/// command line.
+///
+/// This is intentionally a no-op for ordinary processes and on non-macOS
+/// platforms. Embedding executables should call it as the first statement in
+/// `main`, before [`bun_embed_init`] or argument parsing.
+#[unsafe(no_mangle)]
+pub(crate) extern "C" fn bun_embed_run_internal_process_mode() {
+    #[cfg(target_os = "macos")]
+    if let Some(fd_str) = bun_core::env_var::BUN_INTERNAL_WEBVIEW_HOST::get() {
+        let fd: u32 = match bun_core::parse_int::<u32>(fd_str, 10).ok() {
+            Some(value) if value <= i32::MAX as u32 => value,
+            _ => output::panic(format_args!(
+                "Invalid BUN_INTERNAL_WEBVIEW_HOST fd: {}",
+                bstr::BStr::new(fd_str),
+            )),
+        };
+        unsafe extern "C" {
+            #[link_name = "Bun__WebView__hostMain"]
+            safe fn webview_host_main(fd: i32) -> !;
+        }
+        webview_host_main(fd as i32);
+    }
+}
+
+#[inline]
+unsafe fn vm_mut<'a>(vm: *mut c_void) -> &'a mut VirtualMachine {
+    debug_assert!(!vm.is_null());
+    // SAFETY: `vm` was returned by `bun_embed_vm_create` on this thread and is
+    // never freed (the embedded VM is process-lifetime, like the CLI's).
+    unsafe { &mut *vm.cast::<VirtualMachine>() }
+}
+
+/// Process-wide initialisation. Idempotent; safe to call from any thread, but
+/// the thread that calls it first should be the future JS thread.
+///
+/// * `argc`/`argv`: what `process.argv` / `Bun.argv` will report. The strings
+///   must live for the whole process.
+/// * `install_crash_handler`: install Bun's SIGSEGV/SIGBUS/… handlers and its
+///   Rust panic hook (which prints a Bun-style crash report). Hosts that have
+///   their own crash reporting should pass `false`.
+///
+/// # Safety
+/// `argv` must point to `argc` NUL-terminated C strings that live for the
+/// process lifetime.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_init(
+    argc: c_int,
+    argv: *const *const c_char,
+    install_crash_handler: bool,
+) {
+    PROCESS_INIT.call_once(|| {
+        // SAFETY: forwarded verbatim from the caller, who upholds the contract
+        // documented above (same contract as the C runtime's `main`).
+        unsafe { bun_core::init_argv(argc, argv) };
+        bun_crash_handler::cli_state::set_main_thread_id(bun_threading::current_thread_id());
+        bun_core::set_start_time(bun_core::time::nano_timestamp());
+
+        // A few runtime APIs still read Bun's process-global CLI context even
+        // when they are not entered through the CLI. In particular,
+        // `Bun.serve()` consults `Command::get().debug.silent` when installing
+        // its idle-timeout warning. The regular executable publishes a
+        // default `ContextData` before creating the VM; without the equivalent
+        // embed setup that accessor dereferences a null global pointer on the
+        // first HTTP request.
+        //
+        // Keep this context independent of any one per-thread VM. Both boxes
+        // are process-lifetime, matching the CLI's static context and log.
+        if bun_options_types::context::try_get().is_none() {
+            let log: &'static mut bun_ast::Log =
+                Box::leak(Box::new(bun_ast::Log::default()));
+            let mut context = Box::new(bun_options_types::context::ContextData::default());
+            context.log = core::ptr::from_mut(log);
+            context.start_time = bun_core::start_time();
+            let context = Box::leak(context);
+            // SAFETY: `context` is leaked and therefore outlives the process;
+            // `PROCESS_INIT` serializes this one-time publication.
+            unsafe { bun_options_types::context::set_global(context) };
+        }
+
+        if install_crash_handler {
+            bun_crash_handler::init();
+        }
+
+        // Bun's socket/subprocess code assumes SIGPIPE is ignored (same as
+        // `bin_entry::main`).
+        // SAFETY: valid signal number and disposition.
+        #[cfg(unix)]
+        unsafe {
+            libc::signal(libc::SIGPIPE, libc::SIG_IGN);
+        }
+
+        // stdout/stderr writers + `bun_initialize_process()` (fd 0-2 sanity,
+        // tty state).
+        output::stdio::init();
+        StackCheck::configure_thread();
+    });
+}
+
+/// Create the (per-thread) VM. Returns null on failure; see
+/// [`bun_embed_last_error`].
+///
+/// `cwd` is the working directory used for module resolution and
+/// `process.cwd()`; it must be an absolute path.
+///
+/// After this returns the calling thread holds the JSC API lock for good, so
+/// every JavaScriptCore C API call from this thread is already locked.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_create(
+    cwd_ptr: *const u8,
+    cwd_len: usize,
+) -> *mut c_void {
+    // SAFETY: forwarded unchanged; this is the ordinary `bun run`-compatible
+    // mode and deliberately does not install a `bun:test` runner.
+    unsafe { bun_embed_vm_create_impl(cwd_ptr, cwd_len, false) }
+}
+
+/// Create a VM configured exactly like Bun's test command, but without CLI
+/// discovery. One file is supplied later through [`bun_embed_test_run_file`].
+/// Test mode is process-exclusive because Bun's `isBunTest` switch and Jest
+/// runner pointer are process globals.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_test_vm_create(
+    cwd_ptr: *const u8,
+    cwd_len: usize,
+) -> *mut c_void {
+    // SAFETY: forwarded unchanged; caller upholds the create contract.
+    unsafe { bun_embed_vm_create_impl(cwd_ptr, cwd_len, true) }
+}
+
+unsafe fn bun_embed_vm_create_impl(
+    cwd_ptr: *const u8,
+    cwd_len: usize,
+    test_mode: bool,
+) -> *mut c_void {
+    if cwd_ptr.is_null() || cwd_len == 0 {
+        set_last_error("bun_embed_vm_create: cwd must be a non-empty absolute path".into());
+        return core::ptr::null_mut();
+    }
+    if let Some(existing_mode) = PROCESS_TEST_MODE.get() {
+        if *existing_mode != test_mode {
+            set_last_error(
+                "bun_embed_vm_create: normal and test VMs cannot coexist in one process".into(),
+            );
+            return core::ptr::null_mut();
+        }
+    } else {
+        let _ = PROCESS_TEST_MODE.set(test_mode);
+    }
+    // SAFETY: caller passes a valid (ptr, len) pair.
+    let cwd: Box<[u8]> = unsafe { core::slice::from_raw_parts(cwd_ptr, cwd_len) }.into();
+
+    // Per-thread pieces of `bin_entry::main` / `Run::boot`.
+    StackCheck::configure_thread();
+    bun_jsc::virtual_machine::isBunTest
+        .store(test_mode, core::sync::atomic::Ordering::Relaxed);
+    bun_jsc::initialize(bun_jsc::InitializeOptions::default());
+    if test_mode {
+        bun_http::http_thread::init(&Default::default());
+    }
+    bun_ast::initialize_store_or_reset();
+
+    let mut transform_options = api::TransformOptions::default();
+    transform_options.absolute_working_dir = Some(cwd.clone());
+
+    let vm_ptr = match VirtualMachine::init(InitOptions {
+        transform_options,
+        is_main_thread: true,
+        ..Default::default()
+    }) {
+        Ok(vm) => vm,
+        Err(err) => {
+            set_last_error(format!("VirtualMachine::init failed: {err:?}"));
+            return core::ptr::null_mut();
+        }
+    };
+    // SAFETY: `init` returns the unique freshly-boxed VM on this thread.
+    let vm = unsafe { &mut *vm_ptr };
+    vm.transpiler.options.rewrite_jest_for_tests = test_mode;
+
+    // Same env/define wiring as `Run::boot`, without the CLI's `ctx`. Bun's
+    // test command inserts NODE_ENV before configuring defines.
+    if test_mode {
+        let env = vm.transpiler.env_mut();
+        let node_env_entry = match env.map.get_or_put_without_value(b"NODE_ENV") {
+            Ok(entry) => entry,
+            Err(_) => {
+                set_last_error("bun_embed_test_vm_create: cannot set NODE_ENV".into());
+                return core::ptr::null_mut();
+            }
+        };
+        if !node_env_entry.found_existing {
+            *node_env_entry.key_ptr = Box::<[u8]>::from(&**node_env_entry.key_ptr);
+            *node_env_entry.value_ptr = bun_dotenv::HashTableValue {
+                value: Box::<[u8]>::from(b"test" as &[u8]),
+            };
+        }
+    }
+    let defines_ok = {
+        let b = &mut vm.transpiler;
+        b.options.env.behavior = api::DotEnvBehavior::LoadAllWithoutInlining;
+        b.configure_defines().is_ok()
+    };
+    if !defines_ok {
+        set_last_error("bun_embed_vm_create: configure_defines failed".into());
+        return core::ptr::null_mut();
+    }
+
+    // SAFETY: `vm.log` is set in `VirtualMachine::init`; `env_loader()` is the
+    // long-lived loader owned by the transpiler.
+    bun_http::async_http::load_env(unsafe { vm.log.unwrap().as_mut() }, vm.env_loader());
+    vm.load_extra_env_and_source_code_printer();
+    vm.is_main_thread = true;
+    bun_jsc::virtual_machine::IS_MAIN_THREAD_VM.set(true);
+
+    if test_mode {
+        let mut tz_name: &[u8] = b"Etc/UTC";
+        if let Some(tz) = vm.env_loader().get(b"TZ") {
+            tz_name = tz;
+        }
+        if !tz_name.is_empty() {
+            let _ = vm
+                .global()
+                .set_time_zone(&EncodedSlice::from_bytes(tz_name));
+        }
+        install_test_reporter();
+    }
+
+    // `Bun.main` / relative resolution anchor. The file does not need to
+    // exist; the host imports through the module loader itself.
+    let mut main = Vec::with_capacity(cwd.len() + 16);
+    main.extend_from_slice(&cwd);
+    if !cwd.ends_with(b"/") {
+        main.push(b'/');
+    }
+    main.extend_from_slice(b"[rbun-host].js");
+    let main: &'static [u8] = Box::leak(main.into_boxed_slice());
+    vm.set_main(main);
+
+    // Hold the JSC API lock for the lifetime of this thread, exactly like
+    // `Run::start` does for the CLI. Every JSC C API call re-enters it
+    // recursively, so the host never has to lock explicitly.
+    core::mem::forget(vm.global().vm().get_api_lock());
+
+    vm_ptr.cast()
+}
+
+fn install_test_reporter() {
+    let test_options: &'static TestOptions = Box::leak(Box::new(TestOptions::default()));
+    let reporter: &'static mut CommandLineReporter = Box::leak(Box::new(CommandLineReporter {
+        jest: TestRunner {
+            current_file: CurrentFile::default(),
+            files: FileList::default(),
+            index: FileMap::default(),
+            only: test_options.only,
+            run_todo: test_options.run_todo,
+            concurrent: test_options.concurrent,
+            randomize_seed: None,
+            concurrent_test_glob: None,
+            bail: test_options.bail,
+            max_concurrency: test_options.max_concurrency,
+            snapshots: Snapshots::init(test_options.update_snapshots),
+            default_timeout_ms: test_options.default_timeout_ms,
+            default_timeout_override: u32::MAX,
+            test_options,
+            filter_regex: None,
+            unhandled_errors_between_tests: 0,
+            summary: Summary::default(),
+            node_test_used: false,
+            bun_test_root: BunTestRoot::init(),
+        },
+        repeat_count: test_options.repeat_count.max(1),
+        last_printed_dot: core::cell::Cell::new(false),
+        worker_ipc_file_idx: None,
+        test_failure: None,
+        failures_to_repeat_buf: Vec::new(),
+        skips_to_repeat_buf: Vec::new(),
+        todos_to_repeat_buf: Vec::new(),
+        reporters: ReportersConfig::default(),
+        timings: None,
+    }));
+
+    // SAFETY: the reporter is leaked, test mode is process-exclusive, and all
+    // runner access happens on this single VM thread.
+    unsafe {
+        jest::Jest::RUNNER.write(Some(core::ptr::NonNull::from(&mut reporter.jest)));
+    }
+    TEST_REPORTER.with(|cell| cell.set(reporter));
+}
+
+/// Load and execute one file with Bun's native `bun:test` runner. The VM is
+/// consumed logically: exit listeners run and the runner is torn down before
+/// this returns, so the host should exit after reading `out_result`.
+///
+/// Return values: 0 passed, 1 test failure, 2 embedding/runner error.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_test_run_file(
+    vm: *mut c_void,
+    path_ptr: *const u8,
+    path_len: usize,
+    out_result: *mut BunEmbedTestResult,
+) -> c_int {
+    if vm.is_null() || path_ptr.is_null() || path_len == 0 || out_result.is_null() {
+        set_last_error("bun_embed_test_run_file: invalid argument".into());
+        return 2;
+    }
+    if PROCESS_TEST_MODE.get().copied() != Some(true) {
+        set_last_error("bun_embed_test_run_file: VM was not created in test mode".into());
+        return 2;
+    }
+    let reporter_ptr = TEST_REPORTER.with(|cell| cell.get());
+    if reporter_ptr.is_null() {
+        set_last_error("bun_embed_test_run_file: test runner was already consumed".into());
+        return 2;
+    }
+
+    // SAFETY: validated pointer/length pairs and process-lifetime VM/reporter.
+    let vm = unsafe { vm_mut(vm) };
+    let path = unsafe { core::slice::from_raw_parts(path_ptr, path_len) };
+    vm.event_loop_ref().ensure_waker();
+
+    let vm_ptr = core::ptr::from_mut(vm);
+    // SAFETY: recursive acquisition of the live VM's API lock; the closure is
+    // the sole mutator and matches `TestCommand::run_all_tests`.
+    let run_result = unsafe {
+        (*vm_ptr).run_with_api_lock(|| {
+            TestCommand::run(
+                &mut *reporter_ptr,
+                &mut *vm_ptr,
+                path,
+                FirstLast {
+                    first: true,
+                    last: true,
+                },
+            )
+        })
+    };
+    if let Err(error) = run_result {
+        set_last_error(format!("bun_embed_test_run_file: {error:?}"));
+        let reporter = unsafe { &mut *reporter_ptr };
+        teardown_test_runner(vm, reporter);
+        return 2;
+    }
+
+    let reporter = unsafe { &mut *reporter_ptr };
+    let inline_snapshots_ok = reporter
+        .jest
+        .snapshots
+        .write_inline_snapshots()
+        .unwrap_or(false);
+    let snapshot_file_ok = reporter.jest.snapshots.write_snapshot_file().is_ok();
+    let snapshots_ok = inline_snapshots_ok && snapshot_file_ok;
+
+    let summary = reporter.jest.summary;
+    let result = BunEmbedTestResult {
+        pass: summary.pass,
+        fail: summary.fail,
+        skip: summary.skip,
+        todo: summary.todo,
+        expectations: summary.expectations,
+        files: summary.files,
+        unhandled_errors: reporter.jest.unhandled_errors_between_tests,
+    };
+    // SAFETY: non-null checked above; plain-C Copy-by-fields value.
+    unsafe { out_result.write(result) };
+
+    let failed = summary.fail > 0
+        || reporter.jest.unhandled_errors_between_tests > 0
+        || !snapshots_ok;
+    vm.exit_handler.exit_code = u8::from(failed);
+    vm.exit_handler.skip_exit_listeners = skip_exit_listeners(reporter);
+    // SAFETY: same single-thread/API-lock contract as Bun's test-command exit.
+    unsafe { (*vm_ptr).run_with_api_lock(|| (&mut *vm_ptr).on_exit()) };
+    teardown_test_runner(vm, reporter);
+    bun_core::Output::flush();
+    i32::from(failed)
+}
+
+fn teardown_test_runner(vm: &mut VirtualMachine, reporter: &mut CommandLineReporter) {
+    let _ = vm;
+    reporter.jest.bun_test_root.deinit_for_exit();
+    // SAFETY: single VM thread; clearing before the leaked reporter becomes
+    // unreachable prevents finalizers observing a partially torn-down runner.
+    unsafe { jest::Jest::RUNNER.write(None) };
+    TEST_REPORTER.with(|cell| cell.set(core::ptr::null_mut()));
+}
+
+/// The VM's global object, usable directly as a `JSGlobalContextRef`.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_global_object(vm: *mut c_void) -> *mut c_void {
+    // SAFETY: see `vm_mut`.
+    let vm = unsafe { vm_mut(vm) };
+    let global: *mut JSGlobalObject = vm.global().as_ptr();
+    global.cast()
+}
+
+/// Configure the entry-point identity and user arguments used by Bun runtime
+/// APIs. The ordinary embedding API starts with a synthetic resolution
+/// anchor; a one-shot `bun run`-style host calls this before importing its
+/// entry module so `Bun.main`, `import.meta.main`, `process.argv`, and
+/// `require.main` see the same native VM state as Bun's CLI.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_configure_entrypoint(
+    vm: *mut c_void,
+    main_ptr: *const u8,
+    main_len: usize,
+    argv_ptrs: *const *const u8,
+    argv_lens: *const usize,
+    argc: usize,
+) -> bool {
+    if vm.is_null()
+        || main_ptr.is_null()
+        || main_len == 0
+        || (argc > 0 && (argv_ptrs.is_null() || argv_lens.is_null()))
+    {
+        set_last_error("bun_embed_vm_configure_entrypoint: invalid argument".into());
+        return false;
+    }
+    // SAFETY: caller supplies the checked live pair for this call. Bun keeps
+    // `main` as a back-reference, so clone and leak it process-lifetime.
+    let main: &'static [u8] = unsafe {
+        Box::leak(
+            core::slice::from_raw_parts(main_ptr, main_len)
+                .to_vec()
+                .into_boxed_slice(),
+        )
+    };
+    let vm = unsafe { vm_mut(vm) };
+    vm.set_main(main);
+    vm.main_hash = bun_watcher::Watcher::get_hash(main);
+    vm.main_resolved_path = bun_core::String::EMPTY;
+    vm.overridden_main.deinit();
+
+    let mut argv = Vec::with_capacity(argc);
+    for index in 0..argc {
+        // SAFETY: the caller supplies `argc`-element pointer/length arrays.
+        let ptr = unsafe { *argv_ptrs.add(index) };
+        let len = unsafe { *argv_lens.add(index) };
+        if ptr.is_null() && len > 0 {
+            set_last_error(format!(
+                "bun_embed_vm_configure_entrypoint: argv[{index}] is null"
+            ));
+            return false;
+        }
+        let bytes = if len == 0 {
+            &[]
+        } else {
+            // SAFETY: caller supplies a live pair for every argument.
+            unsafe { core::slice::from_raw_parts(ptr, len) }
+        };
+        argv.push(bytes.to_vec().into_boxed_slice());
+    }
+    vm.argv = argv;
+    true
+}
+
+/// Execute `source` through Bun's native `[eval]` entry path. The VM must
+/// first be configured with an entry path ending in `/[eval]`; unlike a
+/// dynamic module import, this feeds `module_loader.eval_source`, which is
+/// what gives `bun -e` its static-import/TLA and `import.meta.main` behavior.
+/// Returns 0 on success, 1 after reporting a rejected entry promise, and 2
+/// for an embedding/loader error recorded in [`bun_embed_last_error`].
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_run_eval(
+    vm: *mut c_void,
+    source_ptr: *const u8,
+    source_len: usize,
+) -> c_int {
+    if vm.is_null() || (source_ptr.is_null() && source_len > 0) {
+        set_last_error("bun_embed_vm_run_eval: invalid argument".into());
+        return 2;
+    }
+    let vm = unsafe { vm_mut(vm) };
+    let main: &'static [u8] = Box::leak(vm.main().to_vec().into_boxed_slice());
+    if !main.ends_with(b"/[eval]") {
+        set_last_error("bun_embed_vm_run_eval: VM entrypoint must end in /[eval]".into());
+        return 2;
+    }
+    let source: &'static [u8] = if source_len == 0 {
+        b""
+    } else {
+        // SAFETY: caller supplies a live pair; clone it before returning.
+        Box::leak(
+            unsafe { core::slice::from_raw_parts(source_ptr, source_len) }
+                .to_vec()
+                .into_boxed_slice(),
+        )
+    };
+    vm.module_loader.eval_source = Some(Box::new(bun_ast::Source::init_path_string(main, source)));
+    let promise_ptr = match vm.load_entry_point(main) {
+        Ok(promise) => promise,
+        Err(error) => {
+            set_last_error(format!("bun_embed_vm_run_eval: {error:?}"));
+            return 2;
+        }
+    };
+    let promise = JSValue::from_cell(promise_ptr)
+        .as_any_promise()
+        .expect("load_entry_point returns a promise");
+    if promise.status() == PromiseStatus::Rejected {
+        let reason = promise.result(vm.jsc_vm());
+        vm.run_error_handler(reason, None);
+        vm.exit_handler.exit_code = 1;
+        vm.exit_handler.requested = true;
+        return 1;
+    }
+    0
+}
+
+/// Run one non-blocking event-loop tick (tasks, immediates, microtasks).
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_tick(vm: *mut c_void) {
+    // SAFETY: see `vm_mut`.
+    unsafe { vm_mut(vm) }.tick();
+}
+
+/// Drain the microtask queue only.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_drain_microtasks(vm: *mut c_void) {
+    // SAFETY: see `vm_mut`.
+    unsafe { vm_mut(vm) }.drain_microtasks();
+}
+
+/// Whether anything (timers, sockets, pending tasks, …) keeps the loop alive.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_is_event_loop_alive(vm: *mut c_void) -> bool {
+    // SAFETY: see `vm_mut`.
+    unsafe { vm_mut(vm) }.is_event_loop_alive()
+}
+
+/// Block in the I/O loop until the next event while there is something to
+/// wait for (`auto_tick_active`), then process it. Returns immediately when
+/// the loop is idle.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_auto_tick_active(vm: *mut c_void) {
+    // SAFETY: see `vm_mut`.
+    unsafe { vm_mut(vm) }.auto_tick_active();
+}
+
+/// Run the event loop until nothing keeps it alive — the core of the CLI's
+/// `Run::start` loop.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_run_until_idle(vm: *mut c_void) {
+    // SAFETY: see `vm_mut`.
+    let vm = unsafe { vm_mut(vm) };
+    while vm.is_event_loop_alive() {
+        vm.tick();
+        vm.auto_tick_active();
+    }
+}
+
+/// Finish a one-shot embedding process with Bun's natural-drain lifecycle.
+/// This mirrors the tail of `Run::start`: drain, dispatch `beforeExit`, report
+/// late unhandled rejections, dispatch `exit`, tear down native resources,
+/// and terminate with the VM's exit code. It never returns.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_finish_process(vm: *mut c_void) -> ! {
+    let vm = unsafe { vm_mut(vm) };
+    if !vm.exit_handler.requested {
+        while vm.is_event_loop_alive() {
+            vm.tick();
+            vm.auto_tick_active();
+        }
+        vm.on_before_exit();
+    }
+    let _ = vm.global().handle_rejected_promises();
+    if vm.unhandled_error_counter > 0 {
+        vm.exit_handler.exit_code = 1;
+        vm.exit_handler.requested = true;
+    }
+    vm.on_exit();
+    output::flush();
+    vm.global_exit()
+}
+
+/// Drive the event loop until `promise` settles. Returns 0 when settled, 1
+/// when execution was stopped (termination / forbidden), 2 when the value is
+/// not a promise.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_wait_for_promise(
+    vm: *mut c_void,
+    promise: usize,
+) -> c_int {
+    // SAFETY: see `vm_mut`.
+    let vm = unsafe { vm_mut(vm) };
+    let Some(promise) = JSValue::from_encoded(promise).as_any_promise() else {
+        return 2;
+    };
+    match vm.wait_for_promise(promise) {
+        Ok(()) => 0,
+        Err(_stopped) => 1,
+    }
+}
+
+/// -1 when not a promise, otherwise 0 pending / 1 fulfilled / 2 rejected.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_promise_status(promise: usize) -> c_int {
+    let Some(promise) = JSValue::from_encoded(promise).as_any_promise() else {
+        return -1;
+    };
+    match promise.status() {
+        PromiseStatus::Pending => 0,
+        PromiseStatus::Fulfilled => 1,
+        PromiseStatus::Rejected => 2,
+    }
+}
+
+/// The settled value (fulfillment value or rejection reason) of a promise.
+/// Undefined for pending promises / non-promises.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_promise_result(vm: *mut c_void, promise: usize) -> usize {
+    // SAFETY: see `vm_mut`.
+    let vm = unsafe { vm_mut(vm) };
+    let Some(promise) = JSValue::from_encoded(promise).as_any_promise() else {
+        return JSValue::UNDEFINED.encoded();
+    };
+    if promise.status() == PromiseStatus::Pending {
+        return JSValue::UNDEFINED.encoded();
+    }
+    promise.result(vm.jsc_vm()).encoded()
+}
+
+/// Mark a rejected promise as handled so it is not reported as an unhandled
+/// rejection.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_promise_set_handled(vm: *mut c_void, promise: usize) {
+    // SAFETY: see `vm_mut`.
+    let vm = unsafe { vm_mut(vm) };
+    if let Some(promise) = JSValue::from_encoded(promise).as_any_promise() {
+        promise.set_handled(vm.jsc_vm());
+    }
+}
+
+/// Wake the I/O loop from another thread so a blocked
+/// `bun_embed_vm_auto_tick_active` returns. Thread-safe; the only embed
+/// function that may be called off the VM thread.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_wakeup(vm: *mut c_void) {
+    // SAFETY: `vm` is the live process-lifetime VM; `EventLoop::wakeup` only
+    // touches the uSockets loop's thread-safe wakeup handle.
+    unsafe { &*vm.cast::<VirtualMachine>() }.event_loop_shared().wakeup();
+}
+
+/// Evict a module from the module loader registry so the next import of
+/// `specifier` re-resolves and re-evaluates it (used when a host re-declares
+/// a module under the same name). Returns whether an entry was removed.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_delete_module_registry_entry(
+    vm: *mut c_void,
+    specifier_ptr: *const u8,
+    specifier_len: usize,
+) -> bool {
+    // SAFETY: see `vm_mut`.
+    let vm = unsafe { vm_mut(vm) };
+    // SAFETY: caller passes a valid (ptr, len) pair.
+    let specifier = unsafe { core::slice::from_raw_parts(specifier_ptr, specifier_len) };
+    let name = bun_core::EncodedSlice::from_bytes(specifier);
+    vm.global().delete_module_registry_entry(&name).is_ok()
+}
+
+/// Run a synchronous GC.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_vm_garbage_collect(vm: *mut c_void) -> usize {
+    // SAFETY: see `vm_mut`.
+    unsafe { vm_mut(vm) }.garbage_collect(true)
+}
+
+/// The last error message recorded on this thread (UTF-8, not NUL-terminated;
+/// length via `out_len`). Valid until the next embed call on this thread.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_last_error(out_len: *mut usize) -> *const u8 {
+    LAST_ERROR.with(|cell| {
+        let message = cell.borrow();
+        if !out_len.is_null() {
+            // SAFETY: caller passes a valid out pointer.
+            unsafe { *out_len = message.len() };
+        }
+        message.as_ptr()
+    })
+}
